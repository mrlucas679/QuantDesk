# QuantDesk configuration. Copy to .env and fill in. Never commit the filled file.
#
# Every variable the application reads is listed here. Fourteen were previously undocumented,
# including the autonomous mode selector and the entire experimental-authorization surface, so an
# operator could not discover the settings that decide whether the system trades.

# --- Alpaca credentials and endpoints -------------------------------------------------
# Only the approved paper host is accepted; the application refuses to start otherwise.
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_API_KEY_ID=your-paper-api-key
APCA_API_SECRET_KEY=your-paper-api-secret
# Optional. Defaults to https://data.alpaca.markets. Validated against the approved data host in
# the same way the trading host is, so it can only be pointed at Alpaca market data.
# APCA_API_DATA_URL=https://data.alpaca.markets

# --- Operator control ------------------------------------------------------------------
# Required for every operator mutation endpoint. Blank fails closed. Never log or commit this.
QUANTDESK_OPERATOR_KEY=replace-with-a-long-random-local-operator-key

# --- Instrument universe and order sizing ----------------------------------------------
QUANTDESK_SYMBOLS=SPY,BTC/USD
QUANTDESK_MAX_PAPER_ORDER_NOTIONAL=1000
QUANTDESK_DIAGNOSTIC_MAX_NOTIONAL=10

# --- Autonomous trading ------------------------------------------------------------------
# QUANTDESK_AUTONOMOUS_MODE is the single most safety-critical setting in the system.
#   Disabled          - no autonomous evaluation or execution. The default and the safe state.
#   ExperimentalPaper - requires a complete experimental authorization (see below). Relaxes some
#                       research-readiness gates; it does NOT relax risk, reservation, or
#                       reconciliation.
#   ValidatedPaper    - requires a compatible verified forecast and full runtime readiness.
# Autonomous execution runs only when the mode permits it AND QUANTDESK_AUTONOMOUS_ENABLED=true.
QUANTDESK_AUTONOMOUS_MODE=Disabled
QUANTDESK_AUTONOMOUS_ENABLED=false
# Must also appear in QUANTDESK_SYMBOLS. Note that spot crypto carries a 50 bps round-trip venue
# fee, which makes short-horizon crypto opportunities effectively inadmissible; an equity or
# option symbol clears the same gate roughly an order of magnitude earlier.
QUANTDESK_AUTONOMOUS_SYMBOL=BTC/USD
# How an approved directional view is turned into a position.
#   Spot                - hold the configured instrument directly.
#   DefinedRiskVertical - express the view as a two-leg debit vertical on the configured symbol's
#                         option chain. Maximum loss is the premium paid, capped by
#                         QUANTDESK_AUTONOMOUS_ORDER_NOTIONAL, and the chain is discovered at
#                         runtime. Requires an equity symbol (for example SPY) and options level 2
#                         or above; the symbol stays the underlying because OCC symbols expire and
#                         cannot live in static configuration.
QUANTDESK_AUTONOMOUS_EXPRESSION=Spot
# This is both the position size and the hard cap on what one opportunity can lose. Two floors
# apply and an order must clear both, or it abstains rather than paying the broker for a position
# too small to be worth holding:
#   venue minimum   - the smallest order the venue accepts (crypto $10, equity $1, options $25).
#   economic minimum - the size at which fixed charges stay under a quarter of the expected edge.
# Fixed charges do not shrink with order size, so on a small order they become most of the trade:
# a two-leg option vertical pays about $0.20 in per-contract fees, which is 40 bps of a $50 spread
# but only 6 bps of a $327 one. For DefinedRiskVertical set 500; 20 will refuse every spread.
QUANTDESK_AUTONOMOUS_ORDER_NOTIONAL=20
QUANTDESK_AUTONOMOUS_MAX_HOLDING_HOURS=168
QUANTDESK_AUTONOMOUS_FILL_TIMEOUT_SECONDS=30
QUANTDESK_AUTONOMOUS_CYCLE_INTERVAL_SECONDS=300

# --- Experimental paper authorization ----------------------------------------------------
# Required only when QUANTDESK_AUTONOMOUS_MODE=ExperimentalPaper. The run refuses to start unless
# every field is present and both sanity checks report true.
# QUANTDESK_EXPERIMENT_ID=
# QUANTDESK_HYPOTHESIS_ID=
# QUANTDESK_STRATEGY_VERSION=
# QUANTDESK_EXPERIMENT_REGISTERED_AT=2026-08-31T00:00:00Z
# QUANTDESK_EVIDENCE_REFERENCE=
# QUANTDESK_LEAKAGE_SANITY_PASSED=false
# QUANTDESK_REPLAY_SANITY_PASSED=false

# --- Risk envelope -----------------------------------------------------------------------
# All optional. Each defaults to a multiple of QUANTDESK_AUTONOMOUS_ORDER_NOTIONAL so the envelope
# scales with position size. An invalid or non-positive value falls back to the default rather
# than disabling the limit.
# QUANTDESK_RISK_STRESS_LOSS_PER_TRADE=   # default: 1x notional
# QUANTDESK_RISK_MAX_OPEN_RISK=           # default: 2x notional
# QUANTDESK_RISK_MAX_DAILY_LOSS=          # default: 5x notional
# QUANTDESK_RISK_MAX_CAMPAIGN_LOSS=       # default: 10x notional
# QUANTDESK_RISK_MAX_OPEN_POSITIONS=1
# QUANTDESK_RISK_MAX_DOLLAR_DELTA=        # default: 3x notional
# QUANTDESK_RISK_MAX_DOLLAR_GAMMA=        # default: 1x notional, per 1% underlying move
# QUANTDESK_RISK_MAX_DOLLAR_VEGA=         # default: 1x notional, per vol point
# QUANTDESK_RISK_MAX_RELATIVE_SPREAD=0.01
# QUANTDESK_RISK_MAX_SHORT_CONVEXITY=1

# --- Persistence paths --------------------------------------------------------------------
# Durable execution records. Recovery after a restart reads these, so they must survive redeploys.
# QUANTDESK_DIAGNOSTIC_STORE_PATH=/app/runtime-data/diagnostic-executions.json
# QUANTDESK_MLEG_STORE_PATH=/app/runtime-data/mleg-executions.json

# --- Research plane -------------------------------------------------------------------------
# QUANTDESK_RESEARCH_BASE_URL=http://localhost:8000
# QUANTDESK_RESEARCH_DATA_ROOT=/app/research-data
# QUANTDESK_RESEARCH_ARTIFACT_ROOT=/app/research-artifacts
# Equity research dataset lookback, in calendar days.
# QUANTDESK_EQUITY_LOOKBACK_DAYS=730
# Comma-separated universe the equity dataset publisher exports. Widening this is the
# highest-value research change available: the four default ETFs carry a 0.859 mean pairwise
# correlation and contain no tradable cross-sectional edge.
# QUANTDESK_EQUITY_RESEARCH_SYMBOLS=SPY,QQQ,IWM,DIA

# --- AI evidence agents ---------------------------------------------------------------
# Review, Research, and Policy agents are read-only/proposal-only. They have no broker, secret,
# hard-risk, reservation, reconciliation, or policy-activation tools. Disabled is fail-safe and
# does not prevent deterministic position management.
#
# These four are read from this file only. docker-compose.yml deliberately does not repeat them in
# its environment: block -- doing so consults the shell first and would replace what is written
# here, which is how a working operator key and an Alpaca credential pair were lost before.
QUANTDESK_AGENTS_ENABLED=false
# Featherless exposes the OpenAI-compatible chat-completions endpoint beneath this origin.
# Either form works -- with or without the /v1 the provider's own quickstart shows, with or
# without a trailing slash -- because the client builds the endpoint from the origin rather than
# resolving a relative path against it.
# Keep the credit/API key only in .env or another local secret store; never commit it.
# QUANTDESK_AGENT_BASE_URL=https://api.featherless.ai/v1
# QUANTDESK_AGENT_API_KEY=your-featherless-api-key
# A model identifier your Featherless account can serve. These are HuggingFace-style
# provider/model-id names -- an Ollama tag such as qwen3:8b is not one and will be rejected.
# The agents request response_format=json_object at temperature 0, so choose a model that
# reliably emits strict JSON; a very small one will fail the output contract rather than the call.
# QUANTDESK_AGENT_MODEL=google/gemma-4-31B-it
# Comma-separated numeric expert IDs the deterministic policy validator may accept. An ID must
# also arrive through a currently verified research artifact before Policy Agent is invoked.
# QUANTDESK_AGENT_ALLOWED_EXPERTS=0
